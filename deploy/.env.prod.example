# Copy to deploy/.env.prod on the VM (never commit it).
POSTGRES_PASSWORD=
ADMIN_TOKEN=
BETTER_AUTH_SECRET=
WEB_ORIGIN=https://decabecafc.com.br
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
RESEND_API_KEY=
EMAIL_FROM=De Cabeça <nao-responda@decabecafc.com.br>
# Sentry (errors + performance). Empty: off.
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.1
# Push notifications (once; never change them): pnpm --filter @decabeca/api exec web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:contato@decabecafc.com.br
# Web build (read when the web image builds). Empty: ads off, no Sentry in the browser.
VITE_ADSENSE_CLIENT=
VITE_ADSENSE_SLOT_HOME=
VITE_ADSENSE_SLOT_RESULT=
VITE_ADSENSE_SLOT_TRACK=
VITE_SENTRY_DSN=
# PostHog project key (phc_...): product analytics and session replay. Empty: off.
VITE_POSTHOG_KEY=
