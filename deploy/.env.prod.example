# Copy to deploy/.env.prod on the VM (never commit it).
POSTGRES_PASSWORD=
ADMIN_TOKEN=
BETTER_AUTH_SECRET=
WEB_ORIGIN=https://decabecafc.com.br
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
RESEND_API_KEY=
# Where player feedback (/sugestoes) is e-mailed. Empty: saved only, no e-mail.
FEEDBACK_TO=
EMAIL_FROM=De Cabeça <nao-responda@decabecafc.com.br>
# Sentry (errors + performance). Empty: off.
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.1
# Push notifications (once; never change them; deploy/SETUP-PUSH.md). The browser gets the public key
# from GET /v1/push/key, so the web build needs no VITE_ key. The private key pairs with this public one.
VAPID_PUBLIC_KEY=BDXGt1Qfcr55lVUETBugbez74UKj0P90npVXCPNrmSXtvd1jhESmXahhy1_myK5j4OC66pQ-HwJR51d15MKt5vQ
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:contato@decabecafc.com.br
# Pagamentos (deploy/STRIPE-SETUP.md). Both secrets empty: billing off (the API answers 503).
# Never commit real values. Test keys (sk_test_/rk_test_) until go-live; live keys are refused
# outside NODE_ENV=production. Prefer a restricted key (rk_) with the permissions in the guide.
STRIPE_SECRET_KEY=
# Signing secret of the webhook endpoint https://decabecafc.com.br/v1/billing/webhook (whsec_...).
STRIPE_WEBHOOK_SECRET=
# Price ids (price_...) per product; a missing one is not for sale. Test-mode ids are in the guide;
# live mode has its own ids (copy the catalogue to live, then paste them here).
STRIPE_PRICE_CLUBE_MENSAL=
STRIPE_PRICE_CLUBE_ANUAL=
STRIPE_PRICE_LIGA_PRO=
STRIPE_PRICE_PRESENTE_1M=
STRIPE_PRICE_PRESENTE_3M=
STRIPE_PRICE_PRESENTE_12M=
STRIPE_PRICE_ACABAMENTO_HOLOGRAFICO=
STRIPE_PRICE_ACABAMENTO_CROMADO=
STRIPE_PRICE_PASSAPORTE_RETRO=
STRIPE_PRICE_PASSAPORTE_SELECAO=
STRIPE_PRICE_TORCIDA_CHARANGA=
STRIPE_PRICE_TORCIDA_GERAL=
STRIPE_PRICE_APOIO_MENSAL=
# Web build (read when the web image builds). Empty: ads off, no Sentry in the browser.
# ca-pub-3545965778969941 once the AdSense slots exist (empty: ads and consent banner off).
VITE_ADSENSE_CLIENT=
VITE_ADSENSE_SLOT_HOME=
VITE_ADSENSE_SLOT_RESULT=
VITE_ADSENSE_SLOT_TRACK=
VITE_ADSENSE_SLOT_ALBUM=
VITE_ADSENSE_SLOT_PROFILE=
VITE_SENTRY_DSN=
# PostHog project key (phc_...): product analytics and session replay. Empty: off.
VITE_POSTHOG_KEY=
