# Web image: serves the static build only. It sits behind the edge proxy (deploy/edge.Caddyfile),
# which owns the port, the security headers, compression and the API/PostHog routes.
{
	admin off
	auto_https off
}

:80 {
	root * /srv
	@hashed path /assets/*
	header @hashed Cache-Control "public, max-age=31536000, immutable"
	# Unhashed media: a week, then revalidate in the background for a day.
	@media path /img/* /cutouts/* /audio/* /icon-* /favicon-* /apple-touch-icon.png /og.png
	header @media Cache-Control "public, max-age=604800, stale-while-revalidate=86400"
	@fresh path /sw.js /index.html /manifest.webmanifest
	header @fresh Cache-Control "no-cache"
	try_files {path} /index.html
	file_server
}
