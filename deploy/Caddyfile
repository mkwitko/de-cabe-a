# Web image: serves the static build only. It sits behind the edge proxy (deploy/edge.Caddyfile),
# which owns the port, the security headers, compression and the API/PostHog routes.
{
	admin off
	auto_https off
}

:80 {
	root * /srv
	@hashed path /assets/*
	header @hashed Cache-Control "public, max-age=31536000, immutable"
	# Unhashed media: a week, then revalidate in the background for a day.
	@media path /img/* /cutouts/* /fonts/* /audio/* /icon-* /favicon-* /apple-touch-icon.png /og.png
	header @media Cache-Control "public, max-age=604800, stale-while-revalidate=86400"
	@fresh path /sw.js /index.html /manifest.webmanifest
	header @fresh Cache-Control "no-cache"
	# A level link (/career-path/12): the game's template with the level number filled in, so the
	# link preview names the game and the level (apps/web/scripts/prerender.mjs).
	@level path_regexp level ^/([a-z-]+)/(\d{1,4})/?$
	handle @level {
		@template file /{re.level.1}/fase.html
		handle @template {
			header Cache-Control "no-cache"
			rewrite * /{re.level.1}/fase.html
			templates
			file_server
		}
		handle {
			try_files {path} /index.html
			file_server
		}
	}
	handle {
		# {path}/index.html: the prerendered pages (/career-path, /como-jogar) are folders.
		try_files {path} {path}/index.html /index.html
		file_server
	}
}
