# Local development only. Copy to .env and adjust.
DATABASE_URL=postgresql://decabeca:decabeca@localhost:5432/decabeca
# Admin routes (X-Admin-Token header). Generate with: openssl rand -hex 32
ADMIN_TOKEN=change-me-to-a-long-random-token
PORT=3000
# Bind address; use 0.0.0.0 only inside containers.
HOST=127.0.0.1
# Sign-in (ADR-008). Secret: openssl rand -base64 32 (required in production).
BETTER_AUTH_SECRET=
# Public origin of the web app; Google's redirect URI is <WEB_ORIGIN>/v1/auth/callback/google
WEB_ORIGIN=http://127.0.0.1:5173
# Google OAuth client (Google Cloud Console > APIs & Services > Credentials). Empty: Google off.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Resend (e-mail). Empty: e-mails are printed to the API log.
RESEND_API_KEY=
EMAIL_FROM=De Cabeça <nao-responda@seu-dominio>
# Sentry (errors + performance). Empty: off. The web build reads VITE_SENTRY_DSN.
SENTRY_DSN=
VITE_SENTRY_DSN=
