# Local development only. Copy to .env and adjust.
DATABASE_URL=postgresql://decabeca:decabeca@localhost:5432/decabeca
# Admin routes (X-Admin-Token header). Generate with: openssl rand -hex 32
ADMIN_TOKEN=change-me-to-a-long-random-token
PORT=3000
# Bind address; use 0.0.0.0 only inside containers.
HOST=127.0.0.1
# Sign-in (ADR-008). Secret: openssl rand -base64 32 (required in production).
BETTER_AUTH_SECRET=
# Public origin of the web app; Google's redirect URI is <WEB_ORIGIN>/v1/auth/callback/google
WEB_ORIGIN=http://127.0.0.1:5173
# Google OAuth client (Google Cloud Console > APIs & Services > Credentials). Empty: Google off.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Resend (e-mail). Empty: e-mails are printed to the API log.
RESEND_API_KEY=
# Notificações (GROWTH_PLAN.md 2.9): `pnpm --filter @decabeca/api exec web-push generate-vapid-keys`.
# Empty = push off. Subject: mailto: or https URL of the site.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=
EMAIL_FROM=De Cabeça <nao-responda@seu-dominio>
# Sentry (errors + performance). Empty: off. The web build reads VITE_SENTRY_DSN.
SENTRY_DSN=
VITE_SENTRY_DSN=
# Ads (ADR-012), web build only. Empty: no ad slots rendered.
VITE_ADSENSE_CLIENT=
VITE_ADSENSE_SLOT_TRACK=
VITE_ADSENSE_SLOT_RESULT=
VITE_ADSENSE_SLOT_HOME=
# Pagamentos em modo de teste (deploy/STRIPE-SETUP.md). Empty secrets: billing off.
# Local webhooks: `stripe listen --forward-to 127.0.0.1:3000/v1/billing/webhook` prints the whsec_.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Test-mode prices of the sandbox (not secret).
STRIPE_PRICE_CLUBE_MENSAL=price_1UaL3AD3FzwzVFN9Aa7jbJ4z
STRIPE_PRICE_CLUBE_ANUAL=price_1UaL3ID3FzwzVFN92soqE4eo
STRIPE_PRICE_LIGA_PRO=price_1UaL3BD3FzwzVFN9HtyDtELb
STRIPE_PRICE_PRESENTE_1M=price_1UaL3CD3FzwzVFN9FT6aSQpX
STRIPE_PRICE_PRESENTE_3M=price_1UaL3JD3FzwzVFN9nskSabgt
STRIPE_PRICE_PRESENTE_12M=price_1UaL3JD3FzwzVFN9zuk6eSdS
STRIPE_PRICE_ACABAMENTO_HOLOGRAFICO=price_1UaL3ZD3FzwzVFN9O9qpPDw0
STRIPE_PRICE_ACABAMENTO_CROMADO=price_1UaL3ZD3FzwzVFN9bAbxu92d
STRIPE_PRICE_PASSAPORTE_RETRO=price_1UaL3aD3FzwzVFN92RCjhYeT
STRIPE_PRICE_PASSAPORTE_SELECAO=price_1UaL3aD3FzwzVFN9GOTCRDWq
STRIPE_PRICE_TORCIDA_CHARANGA=price_1UaL3bD3FzwzVFN9HAeF9hks
STRIPE_PRICE_TORCIDA_GERAL=price_1UaL3cD3FzwzVFN93LlbXqUw
# Apoie (/apoie): the monthly apoio; the one-time amount needs no Price (price_data).
STRIPE_PRICE_APOIO_MENSAL=price_1UaLaUD3FzwzVFN9YWzL05Gd
