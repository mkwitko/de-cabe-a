// Data model: docs/DATA_MODEL.md §2. Snapshot immutability trigger and other
// hand-written SQL live in migrations (see the *_snapshot_immutability migration).

generator client {
  provider        = "prisma-client"
  output          = "../src/generated/prisma"
  previewFeatures = ["partialIndexes"]
}

datasource db {
  provider = "postgresql"
}

// ───────────────────────── Knowledge base (§2.1) ─────────────────────────

enum VerificationStatus {
  draft
  imported
  verified
  rejected
}

enum PositionGroup {
  GK
  DF
  MF
  FW
}

enum SpellType {
  professional
  loan
  youth
}

enum DatePrecision {
  day
  month
  year
  unknown
}

/// T1 = global icon; T4 = practice only
enum NotabilityTier {
  T1
  T2
  T3
  T4
}

enum AliasKind {
  canonical
  full
  nickname
  variant
}

model Country {
  id         String   @id @default(uuid(7))
  isoCode    String   @unique /// "BR"
  name       String /// "Brasil"
  wikidataId String?  @unique /// "Q155"
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  clubs                  Club[]
  primaryNationalities   Player[] @relation("primaryNationality")
  secondaryNationalities Player[] @relation("secondaryNationality")
}

model Club {
  id                 String             @id @default(uuid(7))
  name               String /// "Sociedade Esportiva Palmeiras"
  shortName          String /// "Palmeiras"
  countryId          String
  country            Country            @relation(fields: [countryId], references: [id])
  city               String?
  foundedYear        Int?
  wikidataId         String?            @unique
  badgeUrl           String? /// only when the asset licence allows it
  verificationStatus VerificationStatus @default(imported)
  sourceId           String?
  source             Source?            @relation(fields: [sourceId], references: [id])
  sourceRef          String?
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  spells    CareerSpell[] @relation("spellClub")
  loansFrom CareerSpell[] @relation("spellLoanFrom")

  @@index([countryId])
}

model Player {
  id                            String             @id @default(uuid(7))
  canonicalName                 String
  fullName                      String?
  birthDate                     DateTime?
  birthDatePrecision            DatePrecision      @default(unknown)
  nationalityCountryId          String
  nationality                   Country            @relation("primaryNationality", fields: [nationalityCountryId], references: [id])
  secondaryNationalityCountryId String?
  secondaryNationality          Country?           @relation("secondaryNationality", fields: [secondaryNationalityCountryId], references: [id])
  primaryPositionGroup          PositionGroup? /// required before verification (DQ-04)
  /// Other positions the player is known for (Kaká: MF, also FW); Grid accepts any of them.
  secondaryPositionGroups       PositionGroup[]    @default([])
  positionDetail                String?
  /// Wikimedia Commons file of the Wikidata image (P18), with its credit (CC licences need it).
  photoFile                     String?
  photoAuthor                   String?
  photoLicense                  String?
  notabilityTier                NotabilityTier     @default(T3)
  wikidataId                    String?            @unique
  verificationStatus            VerificationStatus @default(imported)
  verifiedAt                    DateTime?
  verifiedBy                    String?
  sourceId                      String?
  source                        Source?            @relation(fields: [sourceId], references: [id])
  sourceRef                     String?
  notes                         String?
  createdAt                     DateTime           @default(now())
  updatedAt                     DateTime           @updatedAt

  aliases  PlayerAlias[]
  spells   CareerSpell[]
  stickers Sticker[]

  @@index([nationalityCountryId])
  @@index([verificationStatus, notabilityTier])
}

model PlayerAlias {
  id         String    @id @default(uuid(7))
  playerId   String
  player     Player    @relation(fields: [playerId], references: [id])
  alias      String /// as displayed: "Zé Roberto"
  normalized String /// normalizeName(alias): "ze roberto"
  kind       AliasKind
  language   String    @default("pt-BR")
  isPrimary  Boolean   @default(false)
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@unique([playerId, normalized])
  @@index([normalized])
}

model CareerSpell {
  id                 String             @id @default(uuid(7))
  playerId           String
  player             Player             @relation(fields: [playerId], references: [id])
  clubId             String
  club               Club               @relation("spellClub", fields: [clubId], references: [id])
  spellType          SpellType
  startDate          DateTime?
  startPrecision     DatePrecision      @default(unknown)
  endDate            DateTime? /// null = still active
  endPrecision       DatePrecision      @default(unknown)
  sortIndex          Int                @default(0) /// manual tie-break
  appearances        Int? /// league games at the club (infobox)
  goals              Int? /// league goals at the club (infobox)
  loanFromClubId     String? /// when spellType = loan
  loanFromClub       Club?              @relation("spellLoanFrom", fields: [loanFromClubId], references: [id])
  verificationStatus VerificationStatus @default(imported)
  verifiedAt         DateTime?
  verifiedBy         String?
  sourceId           String?
  source             Source?            @relation(fields: [sourceId], references: [id])
  sourceRef          String?
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  @@index([playerId, startDate, sortIndex])
  @@index([clubId])
}

model Source {
  id                   String   @id @default(uuid(7))
  code                 String   @unique /// "wikidata", "wikipedia-pt", "manual"
  name                 String
  license              String /// "CC0-1.0", "CC-BY-SA-4.0", "proprietary"
  commercialUseAllowed Boolean
  attributionText      String?
  url                  String?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  clubs   Club[]
  players Player[]
  spells  CareerSpell[]
}

// ───────────────────────── Platform (§2.2) ─────────────────────────

enum GameModeCode {
  CAREER_PATH
  FOOTBALL_GRID
  IMPOSTOR
  TIMELINE
  HIGHER_LOWER
  MISSING_XI
  MYSTERY_PLAYER
  CONNECTIONS
  DRAFT
}

enum ChallengeStatus {
  draft
  validated
  scheduled
  published
  retired
}

model Challenge {
  id             String          @id @default(uuid(7))
  gameMode       GameModeCode
  engineVersion  Int
  publicNumber   Int? /// level number in the game's track (ADR-007); assigned on publish
  status         ChallengeStatus @default(draft)
  difficultyTier Int
  snapshot       Json /// full engine config; immutable once published (DB trigger)
  snapshotHash   String /// sha256 of the canonical snapshot
  version        Int             @default(1)
  supersedesId   String?
  retiredReason  String?
  createdBy      String
  publishedAt    DateTime?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  usages    ChallengePlayerUsage[]
  attempts  Attempt[]
  reports   LevelReport[]
  reactions LevelReaction[]
  community CommunityLevel?

  /// A replacement takes the retired level's number (replace in place), so only published levels are unique.
  @@unique([gameMode, publicNumber], where: raw("status = 'published'"))
  @@index([gameMode, status])
}

/// Divergence between a re-import and an existing record (DATA_QUALITY.md §1)
model ImportDiff {
  id            String    @id @default(uuid(7))
  entityType    String /// "Player" | "Club" | "CareerSpell"
  entityId      String
  field         String
  currentValue  String?
  importedValue String?
  status        String    @default("open") /// open | applied | dismissed
  resolvedBy    String?
  resolvedAt    DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([status])
}

/// A player's report of an error in a finished level (position, missing club, stats, valid
/// answer refused). Reviewed in /admin and by the AI curator (scripts/research/reports.ts).
/// Reações (GROWTH_PLAN.md 2.5): one predefined reaction per player per level, after finishing it.
model LevelReaction {
  challengeId String
  challenge   Challenge @relation(fields: [challengeId], references: [id], onDelete: Cascade)
  pk          String /// account id, or guest session id
  kind        String /// craque | na-trave | que-memoria | pegadinha
  createdAt   DateTime  @default(now())

  @@id([challengeId, pk])
}

model LevelReport {
  id          String    @id @default(uuid(7))
  challengeId String
  challenge   Challenge @relation(fields: [challengeId], references: [id])
  sessionId   String
  reason      String /// position | club_missing | wrong_stats | answer_refused | other
  note        String?
  cellIndex   Int? /// Grid: the cell the report is about
  status      String    @default("open") /// open | fixed | dismissed
  resolution  String?
  resolvedBy  String?
  resolvedAt  DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@unique([challengeId, sessionId])
  @@index([status])
}

/// Analytics events (ANALYTICS.md); no personal data
model Event {
  id          String   @id @default(uuid(7))
  sessionHash String /// short sha256 of the session id
  name        String
  ts          DateTime
  props       Json
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([name, ts])
}

/// For the "no repeated player within 180 days" rule and editorial analytics
model ChallengePlayerUsage {
  challengeId String
  challenge   Challenge @relation(fields: [challengeId], references: [id])
  playerId    String
  role        String /// "answer" (career path) | "example" (grid)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@id([challengeId, playerId, role])
  @@index([playerId])
}

// ───────────────────────── Sessions and attempts (§2.3) ─────────────────────────

model GuestSession {
  id            String   @id @default(uuid(7))
  tokenHash     String   @unique /// sha256 of the cookie token
  userId        String?
  user          User?    @relation(fields: [userId], references: [id])
  lastSeenAt    DateTime
  nickname      String? /// public name in the ranking (guests)
  nicknameKey   String?  @unique /// normalized nickname
  publicProfile Boolean  @default(false) /// /perfil/:nickname visible to anyone (GROWTH_PLAN.md 2.2)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  attempts Attempt[]
  careers  CareerPlayer[]
}

/// Used only by the optional sign-up slice (RF-10); created early to avoid an FK migration
/// Account (ADR-008, Better Auth). Better Auth's `name` is stored as `nickname`.
model User {
  id            String   @id @default(uuid(7))
  email         String   @unique /// lowercased
  emailVerified Boolean  @default(false)
  image         String?
  nickname      String
  nicknameKey   String   @unique
  publicProfile Boolean  @default(false) /// /perfil/:nickname visible to anyone (GROWTH_PLAN.md 2.2)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  sessions     GuestSession[]
  authSessions AuthSession[]
  accounts     Account[]
}

/// Better Auth session (sign-in state). Game progress stays on GuestSession (ADR-004).
model AuthSession {
  id        String   @id
  token     String   @unique
  expiresAt DateTime
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}

/// Sign-in method of a user: "credential" (e-mail + password, scrypt$N$salt$hash) or a provider (google).
model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
}

/// E-mail verification and password reset tokens (Better Auth).
model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
}

enum AttemptStatus {
  IN_PROGRESS
  WON
  LOST
  COMPLETED
}

model Attempt {
  id            String        @id @default(uuid(7))
  sessionId     String
  session       GuestSession  @relation(fields: [sessionId], references: [id])
  challengeId   String
  challenge     Challenge     @relation(fields: [challengeId], references: [id])
  gameMode      GameModeCode /// denormalised for history queries
  engineVersion Int
  state         Json /// current engine state
  status        AttemptStatus
  score         Int           @default(0)
  stars         Int           @default(0) /// 0–3 (ADR-007)
  startedAt     DateTime
  completedAt   DateTime?
  /// Against the clock (ADR-009): chosen at start; past deadlineAt the level ends.
  timed         Boolean       @default(false)
  deadlineAt    DateTime?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  actions AttemptAction[]

  @@unique([sessionId, challengeId]) // one attempt per level per player session (no replay)
  @@index([completedAt])
  @@index([sessionId, completedAt])
}

model AttemptAction {
  id             String   @id @default(uuid(7))
  attemptId      String
  attempt        Attempt  @relation(fields: [attemptId], references: [id])
  seq            Int /// 1..n
  idempotencyKey String
  input          Json
  event          Json
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([attemptId, idempotencyKey])
  @@unique([attemptId, seq])
}

/// Searches without results, by normalized text (DATA_QUALITY.md §5). Editorial only, kept 30 days.
model SearchMiss {
  normalized String   @id
  count      Int      @default(1)
  lastAt     DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([lastAt])
}

/// A real match from an open source (StatsBomb open data, OpenFootball CC0). Raw team names kept;
/// clubId set when the name matches one of our clubs. For future games (Missing XI, Técnico).
model Match {
  id          String        @id @default(uuid(7))
  source      String /// statsbomb | openfootball
  sourceRef   String        @unique /// e.g. "statsbomb:3869685", "openfootball:2023-24/en.1:12"
  competition String
  season      String
  date        DateTime?
  stage       String?
  homeTeam    String
  awayTeam    String
  homeClubId  String?
  awayClubId  String?
  homeScore   Int?
  awayScore   Int?
  lineups     MatchLineup[]
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@index([competition, season])
}

/// One player in a match lineup (StatsBomb). playerId set when the name and nationality match
/// exactly one player of ours.
model MatchLineup {
  id         String  @id @default(uuid(7))
  matchId    String
  match      Match   @relation(fields: [matchId], references: [id], onDelete: Cascade)
  side       String /// home | away
  playerName String
  nickname   String?
  country    String?
  playerId   String?
  position   String?
  jersey     Int?
  starter    Boolean @default(false)

  @@index([matchId])
  @@index([playerId])
}

/// Modo Carreira (docs/GAME_DESIGN/CAREER_MODE.md): the player's own footballer. One active per
/// player (account or guest session); retired ones stay as the player's history.
model CareerPlayer {
  id           String           @id @default(uuid(7))
  sessionId    String
  session      GuestSession     @relation(fields: [sessionId], references: [id])
  name         String
  position     PositionGroup
  /// { finishing, passing, vision, defending, physical } 0–99
  attributes   Json
  /// Training points not yet turned into +1 (per attribute).
  bank         Json
  /// Training points toward the next match (each match costs TRAINING_PER_MATCH).
  matchCredit  Int              @default(0)
  /// For a youth start: the big club whose youth team the player came from.
  originClubId String?
  status       String           @default("active") /// active | retired
  seasons      CareerSeason[]
  training     CareerTraining[]
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  @@index([sessionId, status])
}

/// Stars of one finished level turned into training (one row per attempt; daily cap applies).
model CareerTraining {
  id        String       @id @default(uuid(7))
  careerId  String
  career    CareerPlayer @relation(fields: [careerId], references: [id], onDelete: Cascade)
  attemptId String?
  mode      String /// game mode, or VARIETY for the 3-games-a-day bonus
  attribute String
  points    Int
  day       String /// YYYY-MM-DD in São Paulo
  createdAt DateTime     @default(now())

  @@unique([careerId, attemptId])
  @@index([careerId, day])
}

model CareerSeason {
  id           String        @id @default(uuid(7))
  careerId     String
  career       CareerPlayer  @relation(fields: [careerId], references: [id], onDelete: Cascade)
  number       Int
  clubId       String?
  clubName     String
  tier         String /// BASE | C | B | A | LIB | EUR | UCL
  competition  String
  teamStrength Int
  /// [{ name, clubId, strength, note }] in round order
  opponents    Json
  /// [{ tier, clubId, clubName, label }] once the season is over
  offers       Json?
  finishedAt   DateTime?
  matches      CareerMatch[]
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  @@unique([careerId, number])
}

model CareerMatch {
  id            String       @id @default(uuid(7))
  seasonId      String
  season        CareerSeason @relation(fields: [seasonId], references: [id], onDelete: Cascade)
  round         Int
  opponentName  String
  home          Boolean
  teamGoals     Int
  opponentGoals Int
  playerGoals   Int
  assists       Int
  rating        Float
  headline      String
  note          String?
  createdAt     DateTime     @default(now())

  @@unique([seasonId, round])
}

/// Desafio do Dia (GROWTH_PLAN.md 1.9): the level of each mode that everyone plays on a civil date
/// (America/Sao_Paulo). Drawn once, on the first visit of the day, and never changed after.
model DailyPick {
  day      DateTime     @db.Date
  gameMode GameModeCode
  level    Int /// publicNumber in the mode's track; a level replaced in place keeps its number

  @@id([day, gameMode])
  @@index([gameMode, level])
}

/// Liga de amigos (GROWTH_PLAN.md 2.1): joined by link, weekly ranking of stars, no chat.
/// A player is an account or a guest session, as in the ranking (`pk`).
model League {
  id        String         @id @default(uuid(7))
  code      String         @unique /// 6 letters in the invite link /liga/CODE
  name      String
  createdBy String /// pk of the creator
  createdAt DateTime       @default(now())
  members   LeagueMember[]
  reports   LeagueReport[]
}

model LeagueMember {
  leagueId String
  league   League   @relation(fields: [leagueId], references: [id], onDelete: Cascade)
  /// userId, or the guest session id; a guest who signs up later is matched through its session
  pk       String
  joinedAt DateTime @default(now())

  @@id([leagueId, pk])
  @@index([pk])
}

/// Report of a league's name, for the editor (no automatic action).
model LeagueReport {
  id        String   @id @default(uuid(7))
  leagueId  String
  league    League   @relation(fields: [leagueId], references: [id], onDelete: Cascade)
  pk        String
  reason    String
  createdAt DateTime @default(now())

  @@unique([leagueId, pk])
}

/// Notificações opt-in (GROWTH_PLAN.md 2.9): one browser push subscription per device.
model PushSubscription {
  endpoint  String   @id
  pk        String /// account id, or guest session id
  p256dh    String
  auth      String
  daily     Boolean  @default(true) /// new Desafio do Dia
  league    Boolean  @default(true) /// a league's week closed
  createdAt DateTime @default(now())

  @@index([pk])
}

/// A push batch already sent ("daily:2026-11-10"), so a restart never sends it twice.
model PushSend {
  key       String   @id
  createdAt DateTime @default(now())
}

/// Fantasy de conhecimento (GROWTH_PLAN.md onda 3, versão mínima): 5 real players picked for a
/// week (Monday, Brasília). Saved once and locked until Sunday; only levels started after
/// `createdAt` score, so a squad never profits from answers already seen.
model FantasySquad {
  pk        String /// account id, or guest session id
  week      DateTime @db.Date
  playerIds String[]
  createdAt DateTime @default(now())

  @@id([pk, week])
  @@index([week])
}

/// Modo Copa: one World Cup run (7 matches of questions about real World Cup starters). The
/// state (tournament, current question with its answer, the XI so far) never leaves the server
/// whole; the player sees the question's options only.
model CopaRun {
  id         String   @id @default(uuid(7))
  pk         String
  difficulty String /// facil | normal | dificil
  state      Json
  status     String   @default("playing") /// playing | over
  finish     String? /// Grupos | Oitavas | Quartas | Semifinal | Vice | Campeão
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([pk, status])
}

/// Oficina De Cabeça (GROWTH_PLAN.md 3.2–3.3): a level a player built on an existing mode (Grid
/// first), validated by the same snapshot builder as the editors' levels, approved by hand.
/// States: review (Em revisão) -> published -> featured (Destaque); flagged (Sob revisão) after
/// reports, still playable until an editor decides; archived. Never counts for stars or titles.
model CommunityLevel {
  challengeId String            @id
  challenge   Challenge         @relation(fields: [challengeId], references: [id])
  authorPk    String
  title       String
  state       String            @default("review")
  /// "Apresentado por": a sponsor's name shown as a label (3.5).
  sponsor     String?
  reports     Int               @default(0)
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  votes       CommunityVote[]
  reportRows  CommunityReport[]

  @@index([state, createdAt])
  @@index([authorPk])
}

/// One vote per player, only after finishing the level.
model CommunityVote {
  challengeId String
  level       CommunityLevel @relation(fields: [challengeId], references: [challengeId], onDelete: Cascade)
  pk          String
  up          Boolean
  createdAt   DateTime       @default(now())

  @@id([challengeId, pk])
}

/// One report per player on a community level; three distinct reporters flag it for review.
model CommunityReport {
  challengeId String
  level       CommunityLevel @relation(fields: [challengeId], references: [challengeId], onDelete: Cascade)
  pk          String
  createdAt   DateTime       @default(now())

  @@id([challengeId, pk])
}

/// A dated event (3.4): community levels open for a window, with a ranking and an optional sponsor.
model GameEvent {
  id           String   @id @default(uuid(7))
  slug         String   @unique
  title        String
  description  String
  sponsor      String?
  startsAt     DateTime
  endsAt       DateTime
  challengeIds String[]
  createdAt    DateTime @default(now())
}

enum StickerRarity {
  bronze
  prata
  ouro
  ouro_brilhante
  destaque_rodada
  selecao_temporada
  idolo
  lenda
}

/// One sticker per (player pk, footballer); the best rarity earned is kept.
model Sticker {
  pk          String
  playerId    String
  player      Player        @relation(fields: [playerId], references: [id])
  rarity      StickerRarity
  mode        GameModeCode
  challengeId String
  earnedAt    DateTime      @default(now())
  upgradedAt  DateTime      @updatedAt

  @@id([pk, playerId])
  @@index([pk, rarity])
}

/// One Seleção da Temporada promotion per podium season and player (pk = userId ?? sessionId).
model SeasonPromotion {
  pk        String
  season    Int
  playerId  String
  createdAt DateTime @default(now())

  @@id([pk, season])
}

/// A closed round already checked for Destaque da Rodada upgrades, once per pk.
model RoundCheck {
  pk     String
  monday DateTime @db.Date

  @@id([pk, monday])
}
